{
  // Press F5 to start Next.js with the debugger attached
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Beetcode: debug full stack",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": { "pattern": "- Local:.+(https?://\\S+)", "uriFormat": "%s", "action": "debugWithChrome" }
    }
  ]
}
